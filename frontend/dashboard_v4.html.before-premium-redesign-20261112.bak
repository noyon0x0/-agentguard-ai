<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>AgentGuard AI v4 | Security Operations</title>
  <style>
    :root{color-scheme:dark;--bg:#070b14;--surface:#111a2b;--surface2:#0c1422;--line:#28364b;--cyan:#38bdf8;--green:#10b981;--red:#f43f5e;--amber:#f59e0b;--text:#f1f5f9;--muted:#9aacbf;--shadow:0 14px 40px #0005}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 16% 0,#11203a 0,transparent 40%),var(--bg);color:var(--text);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}button,input,select,textarea{font:inherit}button,a,input,select,textarea{outline-offset:3px}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--cyan)}a{color:var(--cyan)}.shell{max-width:1600px;margin:auto;padding:20px;display:grid;grid-template-columns:235px minmax(0,1fr);gap:18px}.sidebar{position:sticky;top:18px;align-self:start;max-height:calc(100vh - 36px);overflow:auto;background:#0c1422eF;border:1px solid var(--line);border-radius:20px;padding:16px;box-shadow:var(--shadow)}.brand{display:flex;gap:11px;align-items:center;padding:4px 2px 18px;border-bottom:1px solid var(--line)}.brand-mark{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,#0284c7,#10b981);font-size:22px}.brand h1{font-size:16px;margin:0}.brand p{font-size:11px;margin:2px 0 0;color:var(--muted)}.version{color:var(--cyan);font-weight:800}.nav{display:grid;gap:4px;margin-top:13px}.nav a{padding:8px 10px;border-radius:10px;text-decoration:none;color:#c3d0df;font-size:12px}.nav a:hover,.nav a:focus-visible{background:#17263a;color:#fff}.nav-label{margin:16px 9px 4px;color:#71849c;font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:800}.main{min-width:0}.topbar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:16px;padding:15px 18px;background:#101a2bde;border:1px solid var(--line);border-radius:18px}.topbar h2{font-size:19px;margin:0}.topbar p{font-size:12px;color:var(--muted);margin:2px 0 0}.top-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.status{display:inline-flex;align-items:center;gap:7px;padding:6px 10px;border-radius:99px;background:#172337;color:var(--muted);font-size:11px;font-weight:800;border:1px solid var(--line)}.dot{width:8px;height:8px;border-radius:50%;background:currentColor}.ok{color:var(--green)}.bad{color:var(--red)}.warn{color:var(--amber)}.info{color:var(--cyan)}.btn{border:1px solid var(--line);border-radius:10px;background:#18263a;color:var(--text);padding:8px 12px;cursor:pointer;font-weight:750;font-size:12px}.btn:hover{filter:brightness(1.15)}.btn-primary{border:0;background:linear-gradient(90deg,#0284c7,#2563eb)}.btn-green{background:#0e392f;border-color:#166c59;color:#8bf0ce}.btn-red{background:#3c1724;border-color:#7e2639;color:#ffadba}.btn-amber{background:#392d16;border-color:#705321;color:#fbd38d}.btn:disabled{opacity:.55;cursor:wait}.page-title{margin:22px 2px 11px;font-size:18px}.page-title small{font-size:11px;color:var(--muted);font-weight:500;margin-left:8px}.grid{display:grid;gap:14px}.kpis{grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:14px}.cols2{grid-template-columns:repeat(2,minmax(0,1fr))}.cols3{grid-template-columns:repeat(3,minmax(0,1fr))}.card{min-width:0;background:linear-gradient(145deg,#121d2f,#0e1726);border:1px solid var(--line);border-radius:17px;padding:16px;box-shadow:var(--shadow)}.card h3{font-size:14px;margin:0 0 4px}.sub{color:var(--muted);font-size:12px;margin:0 0 12px}.metric-label{font-size:10px;color:var(--muted);font-weight:800;letter-spacing:.08em;text-transform:uppercase}.metric{font-size:28px;font-weight:850;margin-top:8px;letter-spacing:-.03em}.metric-foot{font-size:11px;color:var(--muted)}.cyan{color:var(--cyan)}.green{color:var(--green)}.red{color:var(--red)}.amber{color:var(--amber)}.state{padding:10px 12px;border-radius:11px;background:#0a1220;border:1px solid var(--line);color:var(--muted);font-size:12px;margin:8px 0}.state.error{color:#ffc0ca;border-color:#753044;background:#29131d}.state.empty{color:var(--muted)}.state.loading{color:var(--cyan)}.row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #243248}.row:last-child{border-bottom:0}.row-main{min-width:0}.row-title{font-weight:750;overflow-wrap:anywhere}.row-detail{font-size:11px;color:var(--muted);overflow-wrap:anywhere}.actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.badge{display:inline-flex;border-radius:99px;padding:3px 8px;font-size:10px;font-weight:850;text-transform:uppercase;background:#1c293b;color:var(--muted)}.badge.approve{color:#8bf0ce;background:#0d332b}.badge.review{color:#fbd38d;background:#392d16}.badge.block{color:#ffadba;background:#3c1724}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.field{display:grid;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:10px;text-transform:uppercase;letter-spacing:.07em;font-weight:800;color:#9aacbf}.field input,.field select,.field textarea{width:100%;min-width:0;border:1px solid var(--line);border-radius:10px;background:#080f1b;color:var(--text);padding:10px 11px}.field textarea{min-height:72px;resize:vertical}.field input::placeholder,.field textarea::placeholder{color:#64748b}.field-hint{font-size:10px;color:var(--muted)}.inline{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.inline input{flex:1;min-width:180px}.switch{display:flex;gap:9px;align-items:center;padding:9px 0;color:#d3deea;font-size:12px}.switch input{width:18px;height:18px;accent-color:var(--cyan)}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:12px;text-align:left}caption{text-align:left;color:var(--muted);font-size:11px;padding:0 0 7px}th,td{padding:9px 8px;border-bottom:1px solid #243248;vertical-align:top}th{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}td{overflow-wrap:anywhere}.mono{font-family:ui-monospace,SFMono-Regular,Consolas,monospace}.callout{border-left:3px solid var(--cyan);background:#0c1a29;padding:10px 12px;border-radius:7px;font-size:12px;color:#c3d0df}.callout.warn{border-color:var(--amber)}.callout.danger{border-color:var(--red)}.section{scroll-margin-top:14px;margin-bottom:24px}.hidden{display:none!important}.result{margin-top:12px}.footer-note{color:#71849c;font-size:10px;margin-top:9px}.skip{position:absolute;left:-9999px;top:8px}.skip:focus{left:10px;z-index:4;background:#fff;color:#000;padding:8px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    @media(max-width:1050px){.shell{grid-template-columns:190px minmax(0,1fr);padding:13px;gap:12px}.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.cols3{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:760px){.shell{display:block;padding:10px}.sidebar{position:static;max-height:none;padding:11px;margin-bottom:10px}.brand{padding-bottom:10px}.nav{display:flex;overflow-x:auto;gap:5px;padding:3px 0}.nav-label{display:none}.nav a{white-space:nowrap;border:1px solid var(--line)}.topbar{align-items:flex-start;flex-direction:column}.cols2,.cols3{grid-template-columns:1fr}.page-title{margin-top:20px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}}
    @media(max-width:430px){.kpis{gap:8px}.metric{font-size:23px}.card{padding:13px}.top-actions{width:100%}.status{font-size:10px}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
    .state.ok{color:#8bf0ce;border-color:#166c59;background:#0d241f}.state.warn,.state.review{color:#fbd38d;border-color:#705321;background:#2b2416}.state.block{color:#ffadba;border-color:#7e2639;background:#29131d}
  </style>
</head>
<body>
  <a class="skip" href="#main-content">Skip to main content</a>
  <div class="shell">
    <aside class="sidebar" aria-label="AgentGuard navigation">
      <div class="brand"><div class="brand-mark" aria-hidden="true">🛡️</div><div><h1>AgentGuard AI <span class="version">v4</span></h1><p>Security Operations Platform</p></div></div>
      <nav class="nav" aria-label="Security centers">
        <div class="nav-label">Operations</div>
        <a href="#overview">◈ Overview</a><a href="#agents">♙ AI Agent Management</a><a href="#threats">⌁ Threat Intelligence</a>
        <a href="#policy">⚙ Security Policy</a><a href="#transactions">⇄ Transaction Security</a><a href="#approvals">◷ Human Approvals</a>
        <div class="nav-label">Response & forensics</div>
        <a href="#near">◇ NEAR Testnet Monitor</a><a href="#simulation">⚡ Attack Simulation Lab</a><a href="#audit">▤ Audit & Forensics</a>
        <a href="#emergency">⛨ Emergency Response</a><a href="#telegram">◉ Telegram Monitoring</a><a href="#settings">☷ System Settings</a>
      </nav>
    </aside>

    <main class="main" id="main-content">
      <header class="topbar">
        <div><h2>Agent Security Control Center</h2><p>Policy evaluation and read-only NEAR Testnet monitoring</p></div>
        <div class="top-actions">
          <span id="api-status" class="status" role="status" aria-live="polite"><span class="dot"></span>API: Checking</span>
          <span id="rpc-status" class="status" role="status" aria-live="polite"><span class="dot"></span>NEAR RPC: Checking</span>
          <button id="refresh-all" class="btn" type="button">Refresh data</button>
        </div>
      </header>

      <section class="section" id="overview" aria-labelledby="overview-title">
        <h2 class="page-title" id="overview-title">Overview Dashboard <small>Persisted backend totals</small></h2>
        <div id="overview-state" class="state loading" role="status" aria-live="polite">Loading overview from API…</div>
        <div class="grid kpis">
          <article class="card"><div class="metric-label">Evaluations</div><div class="metric cyan" id="metric-total">—</div><div class="metric-foot">Recorded policy requests</div></article>
          <article class="card"><div class="metric-label">Approved</div><div class="metric green" id="metric-approved">—</div><div class="metric-foot">Policy decisions only; no execution</div></article>
          <article class="card"><div class="metric-label">Blocked</div><div class="metric red" id="metric-blocked">—</div><div class="metric-foot">Recorded security blocks</div></article>
          <article class="card"><div class="metric-label">Human review</div><div class="metric amber" id="metric-review">—</div><div class="metric-foot">Currently awaiting decision</div></article>
        </div>
        <div class="grid cols2">
          <article class="card"><h3>Backend connection</h3><p class="sub">API availability is checked directly.</p><div id="api-detail" class="state loading">Checking API…</div><p id="overview-last" class="footer-note">Latest evaluation: not loaded</p></article>
          <article class="card"><h3>Execution boundary</h3><p class="sub">This dashboard only evaluates policies and queries chain state.</p><div id="execution-state" class="callout">Checking backend execution settings…</div></article>
        </div>
      </section>

      <section class="section" id="agents" aria-labelledby="agents-title">
        <h2 class="page-title" id="agents-title">AI Agent Management</h2>
        <article class="card"><p class="sub">Registered agent states and evaluation counts from SQLite.</p><div id="agents-state" class="state loading">Loading agents…</div><div id="agents-list"></div></article>
      </section>

      <section class="section" id="threats" aria-labelledby="threats-title">
        <h2 class="page-title" id="threats-title">Threat Intelligence Center</h2>
        <div class="grid cols2">
          <article class="card"><h3>Active local detections</h3><p class="sub">Rules loaded in the deterministic backend policy engine. No external threat feed is connected.</p><div id="threat-rules-state" class="state loading">Loading rules…</div><div id="threat-rules"></div></article>
          <article class="card"><h3>Recent blocked evaluations</h3><p class="sub">Evidence from recorded BLOCK decisions.</p><div id="threat-blocks-state" class="state loading">Loading events…</div><div id="threat-blocks"></div></article>
        </div>
      </section>

      <section class="section" id="policy" aria-labelledby="policy-title">
        <h2 class="page-title" id="policy-title">Security Policy Center</h2>
        <article class="card"><p class="sub">Policy updates are enforced by the API and require admin authentication.</p><div id="policy-state" class="state loading">Loading policy…</div>
          <form id="policy-form" class="form-grid">
            <div class="field"><label for="max-tx">Maximum transaction (NEAR)</label><input id="max-tx" name="max_transaction_near" type="number" min="0.00000001" step="any" required></div>
            <div class="field"><label for="daily-limit">Daily agent spending limit (NEAR)</label><input id="daily-limit" name="daily_limit_near" type="number" min="0.00000001" step="any" required></div>
            <div class="field"><label for="review-threshold">Human review above (NEAR)</label><input id="review-threshold" name="review_threshold_near" type="number" min="0" step="any" required></div>
            <div class="field"><label for="velocity-max">Maximum requests per velocity window</label><input id="velocity-max" name="velocity_max_requests" type="number" min="1" step="1" required></div>
            <div class="field"><label for="velocity-window">Velocity window (seconds)</label><input id="velocity-window" name="velocity_window_seconds" type="number" min="1" step="1" required></div>
            <div class="field"><label for="duplicate-window">Duplicate window (seconds)</label><input id="duplicate-window" name="duplicate_window_seconds" type="number" min="1" step="1" required></div>
            <div class="field"><label for="allowlist">Wallet allowlist (one account per line)</label><textarea id="allowlist" name="allowlist" spellcheck="false"></textarea></div>
            <div class="field"><label for="blocklist">Wallet blocklist (one account per line)</label><textarea id="blocklist" name="blocklist" spellcheck="false"></textarea></div>
            <div class="field"><label for="allowed-tools">Allowed tool names (one per line)</label><textarea id="allowed-tools" name="allowed_tools" spellcheck="false"></textarea></div>
            <div class="field"><label for="allowed-contracts">Approved contract accounts (one per line)</label><textarea id="allowed-contracts" name="allowed_contracts" spellcheck="false"></textarea></div>
            <div class="field full"><label class="switch" for="prompt-detection"><input id="prompt-detection" type="checkbox"> Prompt injection detection enabled</label><label class="switch" for="velocity-enabled"><input id="velocity-enabled" type="checkbox"> Velocity guard enabled</label></div>
            <div class="field full"><button class="btn btn-primary" type="submit">Save policy</button><div id="policy-save-state" class="state hidden" role="status" aria-live="polite"></div></div>
          </form>
        </article>
      </section>

      <section class="section" id="transactions" aria-labelledby="transactions-title">
        <h2 class="page-title" id="transactions-title">Transaction Security Center</h2>
        <div class="grid cols2">
          <article class="card"><h3>Evaluate a transaction request</h3><p class="sub">Submits an evaluation request to the backend. It never signs or broadcasts.</p>
            <form id="evaluation-form" class="form-grid">
              <div class="field"><label for="agent-id">Agent identity</label><select id="agent-id" required><option value="agent.testnet">agent.testnet</option><option value="DeFi-Trader-Bot">DeFi-Trader-Bot</option><option value="Auto-Payroll-Agent">Auto-Payroll-Agent</option><option value="Marketing-Grant-Bot">Marketing-Grant-Bot</option><option value="External-Plugin-Agent">External-Plugin-Agent</option></select></div>
              <div class="field"><label for="sender-id">Sender account</label><input id="sender-id" value="agent.testnet" required maxlength="64"></div>
              <div class="field"><label for="recipient-id">Recipient account</label><input id="recipient-id" value="treasury.testnet" required maxlength="64"></div>
              <div class="field"><label for="amount-near">Amount (NEAR)</label><input id="amount-near" type="number" min="0.00000001" step="any" value="2.5" required></div>
              <div class="field full"><label for="prompt-text">Agent prompt</label><textarea id="prompt-text" maxlength="4000">Execute scheduled treasury payment.</textarea></div>
              <div class="field full"><label for="memo-text">Memo</label><input id="memo-text" maxlength="512"></div>
              <div class="field full"><button class="btn btn-primary" type="submit">Evaluate request</button><div id="evaluation-result" class="state empty" role="status" aria-live="polite">No evaluation submitted.</div></div>
            </form>
          </article>
          <article class="card"><h3>Latest evaluation checks</h3><p class="sub">Displayed from the backend response.</p><div id="evaluation-checks" class="state empty">No check results yet.</div></article>
        </div>
      </section>

      <section class="section" id="approvals" aria-labelledby="approvals-title">
        <h2 class="page-title" id="approvals-title">Human Approval Center</h2>
        <article class="card"><p class="sub">Approvals require an authenticated admin token and revalidate current blocking policies.</p><div id="approvals-state" class="state loading">Loading pending approvals…</div><div id="approvals-list"></div></article>
      </section>

      <section class="section" id="near" aria-labelledby="near-title">
        <h2 class="page-title" id="near-title">NEAR Testnet Monitor</h2>
        <div class="grid cols2">
          <article class="card"><h3>RPC health</h3><p class="sub">Network identity is verified against the RPC status response.</p><div id="near-health-state" class="state loading">Checking Testnet RPC…</div><button id="near-health-refresh" class="btn" type="button">Check RPC now</button></article>
          <article class="card"><h3>Account balance and contract lookup</h3><p class="sub">Finalized, read-only account query.</p><form id="near-account-form" class="inline"><label class="sr-only" for="near-account-id">NEAR account ID</label><input id="near-account-id" value="wrap.testnet" maxlength="64" required><button class="btn btn-primary" type="submit">Look up account</button><button id="near-contract-check" class="btn" type="button">Check contract</button></form><div id="near-account-result" class="state empty" role="status" aria-live="polite">No account query yet.</div></article>
          <article class="card"><h3>Verified transaction lookup</h3><p class="sub">Explorer URL appears only if Testnet RPC confirms the transaction hash and signer.</p><form id="near-tx-form" class="form-grid"><div class="field full"><label for="near-tx-hash">Transaction hash</label><input id="near-tx-hash" class="mono" required></div><div class="field full"><label for="near-tx-sender">Sender account ID</label><input id="near-tx-sender" required maxlength="64"></div><div class="field full"><button class="btn btn-primary" type="submit">Verify transaction</button></div></form><div id="near-tx-result" class="state empty" role="status" aria-live="polite">No transaction lookup yet.</div></article>
        </div>
      </section>

      <section class="section" id="simulation" aria-labelledby="simulation-title">
        <h2 class="page-title" id="simulation-title">Attack Simulation Lab</h2>
        <article class="card"><p class="sub">Scenarios invoke the real server-side engine and persist evaluation, test, and audit records. All runs are non-executing.</p>
          <div class="inline"><button id="run-all-simulations" class="btn btn-primary" type="button">Run all 12 scenarios</button><div id="simulation-scorecard" class="state empty" role="status" aria-live="polite">Scorecard not loaded.</div></div>
          <div id="simulation-state" class="state loading">Loading scenario definitions…</div>
          <div class="table-wrap"><table><caption>Backend-defined security scenarios</caption><thead><tr><th>Scenario</th><th>Expected</th><th>Test</th></tr></thead><tbody id="simulation-scenarios"></tbody></table></div>
          <div id="simulation-results" class="grid cols2" aria-live="polite"></div>
        </article>
      </section>

      <section class="section" id="audit" aria-labelledby="audit-title">
        <h2 class="page-title" id="audit-title">Audit &amp; Forensics</h2>
        <article class="card"><div class="inline" style="justify-content:space-between"><p class="sub">Recent persisted audit events. Full access requires admin authentication.</p><button id="export-audit" class="btn" type="button">Export loaded audit data</button></div><div id="audit-state" class="state loading">Loading audit records…</div><div class="table-wrap"><table><caption>Recent audit events returned by the backend</caption><thead><tr><th>Time</th><th>Request ID</th><th>Event</th><th>Decision</th><th>Details</th></tr></thead><tbody id="audit-rows"></tbody></table></div></article>
      </section>

      <section class="section" id="emergency" aria-labelledby="emergency-title">
        <h2 class="page-title" id="emergency-title">Emergency Response Center</h2>
        <article class="card"><div class="callout danger">Freezing an agent blocks future evaluations. This control does not revoke wallet keys or cancel pending blockchain transactions.</div><div id="emergency-agents" class="state loading">Loading agent states…</div></article>
      </section>

      <section class="section" id="telegram" aria-labelledby="telegram-title">
        <h2 class="page-title" id="telegram-title">Telegram Monitoring</h2>
        <article class="card"><p class="sub">Integration status reported by this backend.</p><div id="telegram-state" class="state loading">Checking Telegram integration…</div></article>
      </section>

      <section class="section" id="settings" aria-labelledby="settings-title">
        <h2 class="page-title" id="settings-title">System Settings</h2>
        <div class="grid cols2">
          <article class="card"><h3>Backend configuration</h3><p class="sub">Read-only settings; secrets are never returned.</p><div id="settings-state" class="state loading">Loading settings…</div><dl id="settings-list"></dl></article>
          <article class="card"><h3>Admin session</h3><p class="sub">Used in memory for protected actions on this page. It is not stored or sent to a settings endpoint.</p><form id="admin-form" class="form-grid"><div class="field full"><label for="admin-token">Admin bearer token</label><input id="admin-token" type="password" autocomplete="off" maxlength="512"></div><div class="field full inline"><button class="btn btn-primary" type="submit">Use for this page session</button><button id="clear-admin" class="btn" type="button">Clear token</button></div><div id="admin-state" class="state empty" role="status" aria-live="polite">No admin token entered.</div></form></article>
        </div>
      </section>
      <p class="footer-note">AgentGuard v4 • API-driven status • Transaction signing and submission disabled.</p>
    </main>
  </div>
  <script>
    "use strict";
    // The v4 UI targets the combined main_v3 host on port 8000 by default.
    // Set window.AGENTGUARD_API_BASE before this script to override the API base.
    const servedByAgentGuard = /^https?:$/.test(window.location.protocol)
      && window.location.port === "8000"
      && window.location.pathname === "/dashboard-v4";
    const API_BASE = (window.AGENTGUARD_API_BASE || (
      servedByAgentGuard ? `${window.location.origin}/v4` : "http://127.0.0.1:8000/v4"
    )).replace(/\/+$/, "");
    let adminToken = "";
    let auditCache = [];
    const $ = (id) => document.getElementById(id);

    function node(tag, text, className) {
      const item = document.createElement(tag);
      if (text !== undefined && text !== null) item.textContent = String(text);
      if (className) item.className = className;
      return item;
    }
    function setState(id, message, kind = "empty") {
      const target = $(id);
      target.textContent = message;
      target.className = `state ${kind}`;
    }
    function setConnection(id, label, kind) {
      const target = $(id);
      target.className = `status ${kind}`;
      target.replaceChildren(node("span", null, "dot"), document.createTextNode(label));
    }
    function setBusy(button, busy, busyText) {
      if (!button.dataset.label) button.dataset.label = button.textContent;
      button.disabled = busy;
      button.textContent = busy ? busyText : button.dataset.label;
    }
    function safeError(error) {
      return error instanceof Error ? error.message : "Request failed";
    }
    async function api(path, options = {}) {
      const headers = new Headers(options.headers || {});
      if (options.body && !headers.has("Content-Type")) headers.set("Content-Type", "application/json");
      if (options.admin && adminToken) headers.set("Authorization", `Bearer ${adminToken}`);
      const response = await fetch(`${API_BASE}${path}`, { ...options, headers, signal: AbortSignal.timeout(12000) });
      let body;
      try { body = await response.json(); } catch (_) { body = null; }
      if (!response.ok) {
        const detail = body && body.error ? (body.error.message || body.error.code) : "API request failed";
        throw new Error(`${response.status}: ${detail}`);
      }
      return body;
    }
    function formatDate(value) {
      if (!value) return "—";
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? "—" : date.toLocaleString();
    }
    function decisionBadge(value) {
      const key = String(value || "").toLowerCase();
      return node("span", value || "Unknown", `badge ${key}`);
    }
    function empty(container, message) { container.replaceChildren(node("div", message, "state empty")); }
    function renderRows(container, rows, emptyMessage, renderRow) {
      container.replaceChildren();
      if (!rows || rows.length === 0) { empty(container, emptyMessage); return; }
      for (const value of rows) container.append(renderRow(value));
    }

    async function loadOverview() {
      setState("overview-state", "Loading overview from API…", "loading");
      try {
        const data = await api("/api/v1/overview");
        $("metric-total").textContent = data.total_requests;
        $("metric-approved").textContent = data.approved_count;
        $("metric-blocked").textContent = data.blocked_count;
        $("metric-review").textContent = data.review_count;
        $("overview-last").textContent = `Latest evaluation: ${formatDate(data.last_evaluation_at)}`;
        $("execution-state").textContent = data.execution_enabled === false
          ? "Signing disabled • transaction submission disabled • evaluation records only"
          : "Execution state requires operator review";
        $("execution-state").className = data.execution_enabled === false ? "callout" : "callout danger";
        setState("overview-state", `Loaded ${data.total_requests} persisted evaluations. Total evaluated amount: ${data.evaluated_amount_near} NEAR.`, "ok");
        $("api-detail").textContent = `API reachable at ${API_BASE}; values loaded from SQLite-backed API endpoints.`;
        $("api-detail").className = "state ok";
        setConnection("api-status", "API: Online", "ok");
        return true;
      } catch (error) {
        for (const id of ["metric-total", "metric-approved", "metric-blocked", "metric-review"]) $(id).textContent = "—";
        setState("overview-state", safeError(error), "error");
        setState("api-detail", safeError(error), "error");
        setConnection("api-status", "API: Offline", "bad");
        return false;
      }
    }
    function agentRow(agent, emergency = false) {
      const row = node("div", null, "row");
      const main = node("div", null, "row-main");
      main.append(node("div", agent.agent_id, "row-title mono"));
      main.append(node("div", `${agent.evaluation_count} persisted evaluations • Last: ${formatDate(agent.last_evaluation_at)}`, "row-detail"));
      const controls = node("div", null, "actions");
      const button = node("button", agent.frozen ? "Unfreeze" : (emergency ? "Freeze agent" : "Freeze"), `btn ${agent.frozen ? "btn-green" : emergency ? "btn-red" : ""}`);
      button.type = "button";
      button.setAttribute("aria-label", `${agent.frozen ? "Unfreeze" : "Freeze"} ${agent.agent_id}`);
      button.addEventListener("click", () => freezeAgent(agent.agent_id, !agent.frozen));
      controls.append(node("span", agent.frozen ? "Frozen" : "Active", `badge ${agent.frozen ? "block" : "approve"}`), button);
      row.append(main, controls);
      return row;
    }
    async function loadAgents() {
      setState("agents-state", "Loading agent records…", "loading");
      try {
        const agents = await api("/api/v1/agents");
        renderRows($("agents-list"), agents, "No registered agents.", (agent) => agentRow(agent));
        renderRows($("emergency-agents"), agents, "No registered agents.", (agent) => agentRow(agent, true));
        setState("agents-state", `${agents.length} registered agents from backend state.`, "ok");
      } catch (error) {
        setState("agents-state", safeError(error), "error");
        setState("emergency-agents", safeError(error), "error");
      }
    }
    async function freezeAgent(agentId, frozen) {
      try {
        await api(`/api/v1/agents/${encodeURIComponent(agentId)}`, { method: "PUT", admin: true, body: JSON.stringify({ frozen }) });
        await Promise.all([loadAgents(), loadAudit()]);
      } catch (error) {
        setState("agents-state", safeError(error), "error");
      }
    }
    async function loadThreats() {
      setState("threat-rules-state", "Loading backend rules…", "loading");
      setState("threat-blocks-state", "Loading persisted block events…", "loading");
      try {
        const data = await api("/api/v1/threats");
        renderRows($("threat-rules"), data.rules, "No local detection rules reported.", (rule) => {
          const row = node("div", null, "row");
          const main = node("div", null, "row-main");
          main.append(node("div", rule.id.replaceAll("_", " "), "row-title"));
          main.append(node("div", rule.description, "row-detail"));
          row.append(main, node("span", rule.enabled ? "Enabled" : "Disabled", `badge ${rule.enabled ? "approve" : "review"}`));
          return row;
        });
        renderRows($("threat-blocks"), data.recent_blocks, "No BLOCK evaluations recorded.", (event) => {
          const row = node("div", null, "row");
          const main = node("div", null, "row-main");
          main.append(node("div", `${event.recipient} • ${event.amount_near} NEAR`, "row-title mono"));
          main.append(node("div", `${event.explanation} • ${formatDate(event.created_at)}`, "row-detail"));
          row.append(main, node("span", `Risk ${event.risk_score}`, "badge block"));
          return row;
        });
        setState("threat-rules-state", `Rules reported by ${data.source}; external feed: ${data.external_feed_configured ? "configured" : "not configured"}.`, "ok");
        setState("threat-blocks-state", `${data.recent_blocks.length} persisted block events returned.`, "ok");
      } catch (error) {
        setState("threat-rules-state", safeError(error), "error");
        setState("threat-blocks-state", safeError(error), "error");
      }
    }
    async function loadPolicy() {
      setState("policy-state", "Loading policy…", "loading");
      try {
        const policy = await api("/api/v1/policy");
        $("max-tx").value = policy.max_transaction_near;
        $("daily-limit").value = policy.daily_limit_near;
        $("review-threshold").value = policy.review_threshold_near;
        $("velocity-max").value = policy.velocity_max_requests;
        $("velocity-window").value = policy.velocity_window_seconds;
        $("duplicate-window").value = policy.duplicate_window_seconds;
        $("allowlist").value = policy.allowlist.join("\n");
        $("blocklist").value = policy.blocklist.join("\n");
        $("allowed-tools").value = (policy.allowed_tools || []).join("\n");
        $("allowed-contracts").value = (policy.allowed_contracts || []).join("\n");
        $("prompt-detection").checked = policy.prompt_detection_enabled;
        $("velocity-enabled").checked = policy.velocity_enabled;
        setState("policy-state", "Policy loaded from backend.", "ok");
      } catch (error) { setState("policy-state", safeError(error), "error"); }
    }
    $("policy-form").addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = event.submitter;
      setBusy(button, true, "Saving…");
      const splitList = (id) => $(id).value.split(/\r?\n/).map((item) => item.trim()).filter(Boolean);
      const payload = {
        max_transaction_near: Number($("max-tx").value), daily_limit_near: Number($("daily-limit").value),
        review_threshold_near: Number($("review-threshold").value), velocity_max_requests: Number($("velocity-max").value),
        velocity_window_seconds: Number($("velocity-window").value), duplicate_window_seconds: Number($("duplicate-window").value),
        allowlist: splitList("allowlist"), blocklist: splitList("blocklist"),
        allowed_tools: splitList("allowed-tools"), allowed_contracts: splitList("allowed-contracts"),
        prompt_detection_enabled: $("prompt-detection").checked, velocity_enabled: $("velocity-enabled").checked
      };
      try {
        await api("/api/v1/policy", { method: "PUT", admin: true, body: JSON.stringify(payload) });
        setState("policy-save-state", "Policy update confirmed by backend.", "ok");
        await Promise.all([loadPolicy(), loadThreats(), loadAudit()]);
      } catch (error) { setState("policy-save-state", safeError(error), "error"); }
      finally { setBusy(button, false); }
    });

    function showEvaluation(data, targetId) {
      const target = $(targetId);
      const content = node("div");
      const headline = node("div", null, "inline");
      headline.append(decisionBadge(data.decision), node("span", `Risk ${data.risk_score}/100`, "mono"));
      content.append(headline, node("p", data.explanation, "row-detail"), node("div", `Request ID: ${data.request_id}`, "row-detail mono"));
      target.replaceChildren(content);
      target.className = `state ${String(data.decision).toLowerCase()}`;
    }
    async function submitEvaluation(payload, key) {
      return api("/api/v1/evaluations", {
        method: "POST", headers: { "Idempotency-Key": key }, body: JSON.stringify(payload)
      });
    }
    $("evaluation-form").addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = event.submitter;
      setBusy(button, true, "Evaluating…");
      const payload = {
        agent_id: $("agent-id").value, sender: $("sender-id").value.trim(), recipient: $("recipient-id").value.trim(),
        amount_near: Number($("amount-near").value), prompt: $("prompt-text").value, memo: $("memo-text").value || null
      };
      try {
        const result = await submitEvaluation(payload, `ui-${crypto.randomUUID()}`);
        showEvaluation(result, "evaluation-result");
        const checks = $("evaluation-checks"); checks.replaceChildren();
        for (const [name, value] of Object.entries(result.checks || {})) {
          const row = node("div", null, "row"); row.append(node("span", name.replaceAll("_", " ")), node("span", value, `badge ${value === "PASS" || value === "NOT_REQUIRED" ? "approve" : value === "FAIL" || value === "FROZEN" ? "block" : "review"}`)); checks.append(row);
        }
        checks.className = "state";
        await refreshData();
      } catch (error) { setState("evaluation-result", safeError(error), "error"); }
      finally { setBusy(button, false); }
    });

    async function loadApprovals() {
      setState("approvals-state", "Loading pending approvals…", "loading");
      try {
        const rows = await api("/api/v1/evaluations/pending", { admin: true });
        renderRows($("approvals-list"), rows, "No requests are waiting for human review.", (item) => {
          const row = node("div", null, "row"); const main = node("div", null, "row-main");
          main.append(node("div", `${item.request_id} • ${item.status}`, "row-title mono"));
          main.append(node("div", item.explanation, "row-detail"));
          const actions = node("div", null, "actions");
          for (const action of ["APPROVE", "REJECT"]) {
            const button = node("button", action, `btn ${action === "APPROVE" ? "btn-green" : "btn-red"}`);
            button.type = "button"; button.addEventListener("click", () => resolveApproval(item.request_id, action)); actions.append(button);
          }
          row.append(main, actions); return row;
        });
        setState("approvals-state", `${rows.length} pending review requests from backend.`, "ok");
      } catch (error) { setState("approvals-state", safeError(error), "error"); }
    }
    async function resolveApproval(requestId, action) {
      try {
        const result = await api(`/api/v1/evaluations/${encodeURIComponent(requestId)}/decision`, { method: "POST", admin: true, body: JSON.stringify({ action }) });
        setState("approvals-state", `Backend recorded ${result.decision} for request ${result.request_id}.`, result.decision === "APPROVE" ? "ok" : "warn");
        await refreshData();
      } catch (error) { setState("approvals-state", safeError(error), "error"); }
    }

    async function checkRpcHealth() {
      setState("near-health-state", "Checking Testnet RPC…", "loading");
      setConnection("rpc-status", "NEAR RPC: Checking", "info");
      try {
        const data = await api("/api/v1/near/health");
        setState("near-health-state", `Verified ${data.network} • ${data.latency_ms} ms • checked ${formatDate(data.checked_at)}`, "ok");
        setConnection("rpc-status", "NEAR RPC: Testnet online", "ok");
      } catch (error) {
        setState("near-health-state", safeError(error), "error");
        setConnection("rpc-status", "NEAR RPC: Unavailable", "bad");
      }
    }
    $("near-health-refresh").addEventListener("click", checkRpcHealth);
    async function lookupAccount(contractOnly = false) {
      const id = $("near-account-id").value.trim();
      const target = $("near-account-result");
      setState("near-account-result", "Querying finalized Testnet account state…", "loading");
      try {
        const data = await api(`/api/v1/near/${contractOnly ? "contracts" : "accounts"}/${encodeURIComponent(id)}`);
        const text = contractOnly
          ? `${data.account_id}: ${data.is_contract ? "contract code present" : "no contract code"} • ${data.network} • code hash ${data.code_hash}`
          : `${data.account_id}: ${data.balance_near} NEAR balance • ${data.locked_near} NEAR locked • ${data.is_contract ? "contract account" : "no contract code"} • ${data.network}`;
        setState("near-account-result", text, data.is_contract || !contractOnly ? "ok" : "warn");
      } catch (error) { setState("near-account-result", safeError(error), "error"); }
    }
    $("near-account-form").addEventListener("submit", (event) => { event.preventDefault(); lookupAccount(false); });
    $("near-contract-check").addEventListener("click", () => lookupAccount(true));
    $("near-tx-form").addEventListener("submit", async (event) => {
      event.preventDefault(); setState("near-tx-result", "Verifying transaction status at finality…", "loading");
      const params = new URLSearchParams({ sender_account_id: $("near-tx-sender").value.trim() });
      try {
        const data = await api(`/api/v1/near/transactions/${encodeURIComponent($("near-tx-hash").value.trim())}?${params}`);
        const box = $("near-tx-result"); box.replaceChildren();
        box.append(node("div", `${data.verified ? "Verified" : "Unverified"} Testnet transaction • ${data.transaction_hash}`, "mono"));
        box.append(node("div", `Sender ${data.sender_account_id} • status ${JSON.stringify(data.execution_status)}`, "row-detail"));
        if (data.verified && data.network === "testnet") {
          const link = node("a", "Open verified Testnet explorer record");
          const url = new URL(data.explorer_url);
          if (url.protocol === "https:" && url.hostname === "explorer.testnet.near.org") { link.href = url.href; link.target = "_blank"; link.rel = "noopener noreferrer"; box.append(link); }
        }
        box.className = "state ok";
      } catch (error) { setState("near-tx-result", safeError(error), "error"); }
    });

    function renderSimulationResult(result) {
      const card = node("article", null, "card");
      const heading = node("div", null, "inline");
      heading.append(node("h3", result.scenario.replaceAll("-", " ")), node("span", result.passed ? "PASS" : "FAIL", `badge ${result.passed ? "approve" : "block"}`));
      card.append(heading);
      card.append(node("div", `Test ID ${result.test_id}`, "row-detail mono"));
      card.append(node("div", `Expected ${result.expected_decision} • Actual ${result.actual_decision} • ${result.execution_ms} ms`, "row-detail"));
      card.append(node("p", result.reason, "row-detail"));
      card.append(node("div", `Audit request ID(s): ${result.request_ids.join(", ")}`, "row-detail mono"));
      return card;
    }
    async function loadSimulationLab() {
      setState("simulation-state", "Loading scenario list…", "loading");
      try {
        const [scenarios, scorecard] = await Promise.all([
          api("/api/v1/simulation/scenarios", { admin: true }),
          api("/api/v1/simulation/scorecard", { admin: true })
        ]);
        const body = $("simulation-scenarios"); body.replaceChildren();
        for (const item of scenarios) {
          const row = document.createElement("tr");
          const name = document.createElement("td"); name.append(node("strong", item.scenario), node("div", item.description, "row-detail"));
          const expected = document.createElement("td"); expected.append(decisionBadge(item.expected_decision));
          const action = document.createElement("td");
          const button = node("button", "Run", "btn"); button.type = "button";
          button.addEventListener("click", () => runSimulation(`/api/v1/simulation/run/${encodeURIComponent(item.scenario)}`, button));
          action.append(button); row.append(name, expected, action); body.append(row);
        }
        setState("simulation-state", `${scenarios.length} backend-defined scenarios loaded.`, "ok");
        renderScorecard(scorecard);
        const recent = scorecard.recent_runs || [];
        $("simulation-results").replaceChildren(...recent.map(renderSimulationResult));
      } catch (error) { setState("simulation-state", safeError(error), "error"); }
    }
    function renderScorecard(data) {
      const target = $("simulation-scorecard");
      if (!data.total) { setState("simulation-scorecard", "No simulation runs recorded yet.", "empty"); return; }
      setState("simulation-scorecard", `${data.passed} passed • ${data.failed} failed of ${data.total} runs • ${data.pass_rate_percent}%`, data.failed ? "warn" : "ok");
    }
    async function runSimulation(path, button) {
      setBusy(button, true, "Running…"); setState("simulation-state", "Running backend security scenario(s)…", "loading");
      try {
        const result = await api(path, { method: "POST", admin: true });
        const runs = result.results || [result];
        const previous = Array.from($("simulation-results").children);
        $("simulation-results").replaceChildren(...[...runs.map(renderSimulationResult), ...previous].slice(0, 24));
        const scorecard = result.scorecard || await api("/api/v1/simulation/scorecard", { admin: true });
        renderScorecard(scorecard);
        const passed = runs.filter((item) => item.passed).length;
        const failed = runs.length - passed;
        setState("simulation-state", `Run completed by backend: ${passed} passed, ${failed} failed.`, failed ? "warn" : "ok");
        await Promise.all([loadOverview(), loadThreats(), loadAudit()]);
      } catch (error) { setState("simulation-state", safeError(error), "error"); }
      finally { setBusy(button, false); }
    }
    $("run-all-simulations").addEventListener("click", (event) => runSimulation("/api/v1/simulation/run-all", event.currentTarget));

    async function loadAudit() {
      setState("audit-state", "Loading audit events…", "loading");
      try {
        const rows = await api("/api/v1/audit?limit=100", { admin: true });
        auditCache = rows;
        const body = $("audit-rows"); body.replaceChildren();
        for (const item of rows) {
          const tr = document.createElement("tr");
          for (const value of [formatDate(item.created_at), item.request_id, item.event_type, item.decision, JSON.stringify(item.details)]) {
            const td = document.createElement("td"); td.textContent = value; tr.append(td);
          }
          body.append(tr);
        }
        setState("audit-state", rows.length ? `${rows.length} events loaded from persistent audit storage.` : "Audit API returned no events.", rows.length ? "ok" : "empty");
      } catch (error) { auditCache = []; $("audit-rows").replaceChildren(); setState("audit-state", safeError(error), "error"); }
    }
    $("export-audit").addEventListener("click", () => {
      if (!auditCache.length) { setState("audit-state", "No loaded audit records to export.", "empty"); return; }
      const file = new Blob([JSON.stringify(auditCache, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(file); const link = document.createElement("a");
      link.href = url; link.download = "agentguard-v4-audit.json"; link.click(); URL.revokeObjectURL(url);
    });

    async function loadSettings() {
      setState("settings-state", "Loading backend settings…", "loading");
      try {
        const data = await api("/api/v1/settings");
        const list = $("settings-list"); list.replaceChildren();
        const entries = [
          ["Application", data.app_name], ["Environment", data.environment], ["Database", data.database_backend],
          ["NEAR network", data.near_network_required], ["RPC configured", data.near_rpc_configured ? "Yes" : "No"],
          ["RPC timeout", `${data.near_rpc_timeout_seconds} seconds`], ["Admin auth", data.admin_auth_configured ? "Configured" : "Not configured"],
          ["Transaction signing", data.transaction_signing_enabled ? "Enabled" : "Disabled"],
          ["Transaction submission", data.transaction_submission_enabled ? "Enabled" : "Disabled"]
        ];
        for (const [key, value] of entries) { const row = node("div", null, "row"); row.append(node("dt", key, "row-title"), node("dd", value, "row-detail")); list.append(row); }
        setState("settings-state", "Settings loaded from backend; no secrets returned.", "ok");
      } catch (error) { setState("settings-state", safeError(error), "error"); }
    }
    $("admin-form").addEventListener("submit", (event) => {
      event.preventDefault(); adminToken = $("admin-token").value;
      $("admin-token").value = "";
      setState("admin-state", adminToken ? "Admin token held in page memory for this tab session." : "No admin token entered.", adminToken ? "ok" : "empty");
    });
    $("clear-admin").addEventListener("click", () => { adminToken = ""; $("admin-token").value = ""; setState("admin-state", "Admin token cleared from page memory.", "empty"); });

    async function loadTelegram() {
      setState("telegram-state", "Checking Telegram integration…", "loading");
      try {
        const data = await api("/api/v1/telegram/status");
        setState("telegram-state", `${data.status.toUpperCase()}: ${data.message}`, data.enabled && data.configured ? "ok" : "warn");
      } catch (error) { setState("telegram-state", safeError(error), "error"); }
    }
    async function refreshData() {
      await Promise.allSettled([loadOverview(), loadAgents(), loadThreats(), loadPolicy(), loadApprovals(), loadAudit(), loadSettings(), loadTelegram(), loadSimulationLab(), checkRpcHealth()]);
    }
    $("refresh-all").addEventListener("click", refreshData);
    refreshData();
  </script>
</body>
</html>
