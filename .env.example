# Copy to .env and replace the placeholder with a unique local operator token.
NEAR_HACKATHON_AGENTGUARD_ADMIN_TOKEN=replace-this-with-a-long-random-local-token
NEAR_HACKATHON_AGENTGUARD_ENVIRONMENT=development
NEAR_HACKATHON_AGENTGUARD_LOG_LEVEL=INFO

# RPC remains NEAR Testnet only. Do not set a Mainnet endpoint or credentials.
NEAR_HACKATHON_AGENTGUARD_NEAR_TESTNET_RPC_URL=https://rpc.testnet.near.org
NEAR_HACKATHON_AGENTGUARD_NEAR_RPC_TIMEOUT_SECONDS=5

# Leave transaction execution disabled for the default demo. Read-only account
# monitoring needs only the public sender account. No private key goes here.
NEAR_HACKATHON_AGENTGUARD_NEAR_SENDER_ACCOUNT=
NEAR_HACKATHON_AGENTGUARD_NEAR_PUBLIC_KEY=
NEAR_HACKATHON_AGENTGUARD_NEAR_AUTHORIZED_RECIPIENT=
NEAR_HACKATHON_AGENTGUARD_NEAR_UNAUTHORIZED_RECIPIENT=attacker.testnet
NEAR_HACKATHON_AGENTGUARD_NEAR_TRANSACTIONS_ENABLED=false
